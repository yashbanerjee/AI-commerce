PORT=8787
# Request logging to stdout: 1 (default) or 0 / false to disable. GET /health is never logged.
# HTTP_LOG=1

DATABASE_URL=postgres://postgres:postgres@localhost:5433/aiebot

# Required for encrypting stored data (tenant secrets table, shared OpenAI key in DB)
ENCRYPTION_KEY=change-me-to-32-plus-char-secret-for-local

# Shared OpenAI key for ALL tenants (never exposed to WordPress).
# Option A: set here or in the host environment.
# Option B: leave empty and set via Operator console → System → Save API key (stored encrypted in service_settings).
OPENAI_API_KEY=

OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Chat latency & prompt size (defaults are tuned for fast replies)
# CHAT_COMPLETION_MAX_TOKENS=900
# CHAT_COMPLETION_MAX_TOKENS_CATALOG=2800
# CHAT_QUICK_REPLY_MAX_TOKENS=400
# CHAT_CATALOG_CONTEXT_MAX_CHARS=120000
# CHAT_RETRIEVAL_CHUNK_LIMIT=10
# CHAT_CONTEXT_MAX_CHARS_PER_ITEM=2000

# Log full LLM prompt (all messages) + raw completion JSON string to stdout.
# Default: on when NODE_ENV is not production; in production use 1 to enable, 0 to force off.
# AI_EBOT_LOG_LLM_IO=1

# Optional: self-hosted or Azure OpenAI-compatible base URL
# OPENAI_API_URL=https://api.openai.com/v1

# Optional: KMS CMK ARN — if set, shared key can use KMS; otherwise ENCRYPTION_KEY is used
# KMS_KEY_ID=arn:aws:kms:us-east-1:123456789012:key/...
# AWS_REGION=us-east-1

# Operator admin UI: Bearer token for /v1/admin/* and /admin
# ADMIN_API_KEY=

# Billing (Stripe)
# FREE_TIER_MONTHLY_CHATS=50
# BILLING_UPGRADE_BASE_URL=https://your-site.com/pricing
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_STARTER=
# STRIPE_PRICE_GROWTH=
# STRIPE_PRICE_PRO=
# STRIPE_CHECKOUT_SUCCESS_URL=
# STRIPE_CHECKOUT_CANCEL_URL=
